{
  "name": "swyr",
  "productName": "swyr",
  "version": "0.2.3",
  "description": "swyr, an open-source macOS browser with a vertical sidebar, spaces and a command bar",
  "license": "MIT",
  "author": "Sawyer Smith",
  "private": true,
  "main": "out/main/index.js",
  "build": {
    "appId": "com.swyr.browser",
    "productName": "swyr",
    "copyright": "Copyright © 2026 Sawyer Smith",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/@ghostery/adblocker-electron-preload/**",
      "node_modules/electron-chrome-extensions/dist/chrome-extension-api.preload.js"
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "Apple Development: SAWYER ISAIAH SMITH (53APR7FR2F)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site URL",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Owner"
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "public.html",
              "public.xhtml"
            ]
          }
        ],
        "NSUserActivityTypes": [
          "NSUserActivityTypeBrowsingWeb"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSCameraUsageDescription": "A website you are visiting in swyr wants to use your camera.",
        "NSMicrophoneUsageDescription": "A website you are visiting in swyr wants to use your microphone."
      }
    },
    "dmg": {
      "title": "swyr ${version}",
      "icon": "resources/icon.icns"
    },
    "afterPack": "scripts/after-pack.mjs",
    "publish": [
      {
        "provider": "github",
        "owner": "partypancake8",
        "repo": "swyr-browser"
      }
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "npm run build && node tests/run.mjs",
    "postinstall": "install-electron",
    "licenses": "node scripts/licenses.mjs",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/unit.mjs",
    "behaviour": "electron-vite build && node qa/behaviour.mjs",
    "dist": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=true electron-builder --mac --arm64",
    "icon": "node scripts/make-icon.mjs",
    "audit": "npm audit --omit=dev",
    "sweep": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON qa/sweep.mjs",
    "sitecheck": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON qa/sitecheck.mjs",
    "reliability": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON qa/reliability.mjs",
    "perf": "electron-vite build && node qa/perf.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@ghostery/adblocker-electron": "2.20.3",
    "@mozilla/readability": "0.6.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-link": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "cmdk": "1.1.1",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-updater": "6.8.11",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright": "1.65.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "katex": "0.19.1",
    "adm-zip": "0.6.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "5.1.16"
      }
    }
  }
}
